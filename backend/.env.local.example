# Copiez ce fichier en .env.local et remplissez vos vraies valeurs.

# Service d'envoi d'emails (Mailtrap, Gmail SMTP, etc.)
MAILER_DSN=smtp://IDENTIFIANT:MOTDEPASSE@sandbox.smtp.mailtrap.io:2525

# Clé API OpenWeatherMap (gratuite sur https://openweathermap.org/api)
# Sans elle, la météo des évènements ne s'affiche simplement pas (aucune erreur).
OPENWEATHER_API_KEY=votre_cle_api